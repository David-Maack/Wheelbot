# Local overrides — copy to config.local.yaml (gitignored).
#
# This file is loaded AFTER config.yaml and overlays per top-level section.
# Use it for environment-specific tweaks (paper vs live, tighter limits during
# the §12 phased rollout, dry-run during smoke testing).
#
# Recommended starting point for §12 Phase 1 (single ticker, Alpaca paper):

account:
  broker: alpaca_paper

wheel:
  max_concurrent_positions: 4
  # Alpaca paper feed returns no OI/volume — drop those gates and rely on
  # bid_ask_spread_max_pct as the liquidity proxy. Restore real thresholds
  # when you switch to Tastytrade.
  open_interest_min: 0
  volume_min: 0

risk:
  daily_loss_kill_switch_pct: 3   # tighter while learning

intelligence:
  llm_screener_enabled: false       # off in Phase 1
  llm_news_check_enabled: true      # on — Haiku catches catalysts cheaply
  llm_roll_advisor_enabled: false   # on after ~3 months of cycle data

# Disable specific strategies without editing config.yaml. Strategies in
# this list are skipped at load time even if enabled=true in config.yaml.
disabled_strategies:
  - put_spread     # comes online when multi-leg orders ship in sub-sprint 3

# When you're ready to flip to Tastytrade sandbox:
# account:
#   broker: tastytrade_sandbox
#
# When you're ready to go live:
# account:
#   broker: tastytrade
# wheel:
#   max_concurrent_positions: 4         # back to default
#   max_position_pct_of_account: 30
# risk:
#   daily_loss_kill_switch_pct: 5
# intelligence:
#   llm_screener_enabled: true
#   llm_news_check_enabled: true
