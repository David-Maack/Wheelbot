# Copy to config/secrets.env and fill in. Never commit secrets.env.

# --- Tastytrade (production / sandbox) ---
# Get TASTYTRADE_PROVIDER_SECRET from your developer-portal app at
# https://developer.tastytrade.com. Capture TASTYTRADE_REMEMBER_TOKEN with
# `python -m scripts.bootstrap_tastytrade [--sandbox|--prod]`.
TASTYTRADE_PROVIDER_SECRET=
TASTYTRADE_REMEMBER_TOKEN=
TASTYTRADE_ACCOUNT_NUMBER=
TASTYTRADE_USE_SANDBOX=true

# --- Alpaca (paper) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# --- Anthropic (LLM) ---
ANTHROPIC_API_KEY=

# --- Earnings calendar ---
FINNHUB_API_KEY=

# --- Dashboard ---
WHEELBOT_DASHBOARD_PASSWORD=

# --- Optional overrides ---
# WHEELBOT_DB_PATH=/mnt/wheelbot-storage/wheelbot.db
# WHEELBOT_CONFIG_DIR=/opt/wheelbot/config
